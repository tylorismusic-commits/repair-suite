<https://github.com/tylorismusic-commits/repair-suite#preset_Vinyl_Gentle> a pset:Preset ;
  lv2:appliesTo <https://github.com/tylorismusic-commits/repair-suite> ;
  rdfs:label "Vinyl Gentle" ;
  rdfs:comment "Light crackle removal, 20 Hz rumble filter and a soft noise floor." ;
  pset:bank <https://github.com/tylorismusic-commits/repair-suite#bank_Vinyl> ;
  lv2:port [ lv2:symbol "power" ; pset:value 1 ] ;
  lv2:port [ lv2:symbol "input" ; pset:value 0 ] ;
  lv2:port [ lv2:symbol "output" ; pset:value 0 ] ;
  lv2:port [ lv2:symbol "delta" ; pset:value 0 ] ;
  lv2:port [ lv2:symbol "dc_on" ; pset:value 1 ] ;
