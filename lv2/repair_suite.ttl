@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix idpy: <http://harrisonconsoles.com/lv2/inlinedisplay#> .

idpy:interface a lv2:ExtensionData .
idpy:queue_draw a lv2:Feature .

# ---- plugin ----
@prefix repair: <https://github.com/tylorismusic-commits/repair-suite> .

<https://github.com/tylorismusic-commits/repair-suite> a lv2:Plugin, doap:Project ;
  doap:name "Repair Suite" ;
  doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
  doap:maintainer [ foaf:name "tylorismusic" ] ;
  lv2:optionalFeature lv2:hardRTCapable , idpy:queue_draw ;
  lv2:extensionData idpy:interface , state:interface ;
  lv2:port
    <#audio_in_l> , <#audio_in_r> , <#audio_out_l> , <#audio_out_r> ,
    <#power> ,
    <#input> ,
    <#output> ,
    <#delta> ,
    <#dc_on> ,
    <#dc_freq> ,
    <#clip_on> ,
    <#clip_mode> ,
    <#clip_auto> ,
    <#clip_upper> ,
    <#clip_lower> ,
    <#clip_iter> ,
    <#clip_headroom> ,
    <#clip_mix> ,
    <#click_on> ,
    <#click_mode> ,
    <#click_sens> ,
    <#click_width> ,
    <#click_link> ,
    <#click_mix> ,
    <#hum_on> ,
    <#hum_auto> ,
    <#hum_freq> ,
    <#hum_harmonics> ,
    <#hum_odd> ,
    <#hum_depth> ,
    <#hum_precision> ,
    <#hum_mix> ,
    <#noise_on> ,
    <#noise_adaptive> ,
    <#noise_reduction> ,
    <#noise_tonal> ,
    <#noise_smooth> ,
    <#noise_transient> ,
    <#noise_frame> ,
    <#noise_mix> ,
    <#verb_on> ,
    <#verb_amount> ,
    <#verb_tail> ,
    <#verb_predelay> ,
    <#verb_transient> ,
    <#verb_tilt> ,
    <#verb_mix> ,
    <#spec_on> ,
    <#spec_op> ,
    <#spec_amount> ,
    <#spec_preserve> ,
    <#spec_mix> ,
    <#monitor> ,
    <#audition> ;
  lv2:port
    <#learn_input> , <#learn_sib> , <#compare> ,
    <#comp_gr> , <#sib_gr> , <#harsh_gr> , <#lim_gr> ,
    <#in_l> , <#in_r> , <#out_l> , <#out_r> ,
    <#input_learn_peak> , <#sib_learn_hz> , <#sib_learn_valid> ,
    <#host_bpm> , <#host_tempo> , <#latency> , <#time> ;
  ui:ui <#ui> .

<#ui> a ui:X11UI ;
  ui:binary <repair_suite_ui.so> ;
  lv2:optionalFeature ui:resize ;
  lv2:requiredFeature ui:idleInterface ;
  lv2:extensionData ui:idleInterface .

<#audio_in_l> a lv2:AudioPort, lv2:InputPort ;
  lv2:index 0 ; lv2:symbol "audio_in_l" ; lv2:name "Audio In L" .

<#audio_in_r> a lv2:AudioPort, lv2:InputPort ;
  lv2:index 1 ; lv2:symbol "audio_in_r" ; lv2:name "Audio In R" .

<#audio_out_l> a lv2:AudioPort, lv2:OutputPort ;
  lv2:index 2 ; lv2:symbol "audio_out_l" ; lv2:name "Audio Out L" .

<#audio_out_r> a lv2:AudioPort, lv2:OutputPort ;
  lv2:index 3 ; lv2:symbol "audio_out_r" ; lv2:name "Audio Out R" .

<#power> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 4 ;
  lv2:symbol "power" ;
  lv2:name "Power" ;
  lv2:default 1 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#input> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 5 ;
  lv2:symbol "input" ;
  lv2:name "Input" ;
  lv2:default 0 ;
  lv2:minimum -18 ;
  lv2:maximum 18 ;
  units:unit units:db ;
  rdfs:comment "Recommended -6 to 6" .

<#output> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 6 ;
  lv2:symbol "output" ;
  lv2:name "Output" ;
  lv2:default 0 ;
  lv2:minimum -18 ;
  lv2:maximum 18 ;
  units:unit units:db ;
  rdfs:comment "Recommended -6 to 6" .

<#delta> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 7 ;
  lv2:symbol "delta" ;
  lv2:name "Delta" ;
  lv2:default 0 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#dc_on> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 8 ;
  lv2:symbol "dc_on" ;
  lv2:name "DC Filter" ;
  lv2:default 0 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#dc_freq> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 9 ;
  lv2:symbol "dc_freq" ;
  lv2:name "Rumble" ;
  lv2:default 20 ;
  lv2:minimum 5 ;
  lv2:maximum 60 ;
  units:unit units:hz ;
  rdfs:comment "Recommended 10 to 30" .

<#clip_on> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 10 ;
  lv2:symbol "clip_on" ;
  lv2:name "De-Clip On" ;
  lv2:default 1 ;
  lv2:minimum 0 ;
  lv2:maximum 1 ;
  lv2:portProperty lv2:integer ;
  lv2:portProperty lv2:toggled ;
  rdfs:comment "Recommended 0 to 1" .

<#clip_mode> a lv2:InputPort, lv2:ControlPort ;
  lv2:index 11 ;
  lv2:symbol "clip_mode" ;
  lv2:name "Mode" ;
  lv2:default 0 ;
  lv2:minimum 0 ;
  lv2:maximum 2 ;
  lv2:portProperty lv2:integer ;
  lv2:scalePoint [ rdfs:label "High" ; rdf:value 0 ] ;
  lv2:scalePoint [ rdfs:label "Balanced" ; rdf:value 1 ] ;
  lv2:scalePoint [ rdfs:label "Fast" ; rdf:value 2 ] ;
  rdfs:comment "Recommended 0 to 2" .

<#clip_auto> a lv2:InputPort, lv2:ControlPort ;
